<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.owl-ontologies.com/Ontology1793785230.owl#"
     xml:base="http://www.owl-ontologies.com/Ontology1793785230.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#">
    <owl:Ontology rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#apresa_a -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#apresa_a">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#esta_preso_por"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Modela qu&amp;#233; personaje captura a otro.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#es_asesinado_por -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#es_asesinado_por">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#mata_a"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Inversa de mata_a.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#es_hijo_de -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#es_hijo_de">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_hijo"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Modelo el parectesco familiar entre Personajes.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#es_liberado_por -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#es_liberado_por">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#libera_a"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Inversa de libera_a.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#esta_en_posesion_de -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#esta_en_posesion_de">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_objeto"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Inversa de tiene_objeto.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#esta_preso_por -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#esta_preso_por">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Inversa de apresa_a.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#libera_a -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#libera_a">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Modela qu&amp;#233; personaje libera a otro de su cautiverio.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#localiza_a -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#localiza_a">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Indica que un personaje ha descubierto a otro personaje u objeto.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#mata_a -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#mata_a">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Registra la acci&amp;#243;n de asesinar a otro personaje.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#proporciona_capacidad -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#proporciona_capacidad">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad"/>
        <rdfs:comment>Relaciona a un Objeto con una Capacidad que permite adquirir a quien lo 
    posee.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_capacidad -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_capacidad">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Relaciona a un Personaje con una Capacidad que posee o puede utilizar.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_enojo -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_enojo">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Dios"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Relaciona a un Personaje con un Dios que le castiga con su enojo.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_favor -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_favor">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Dios"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Relaciona a un Personaje con un Dios del que recibe su favor.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_hijo -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_hijo">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Inversa de es_hijo_de.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_objeto -->

    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_objeto">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Relaciona a un Personaje con un Objeto que posee.
    &lt;/p&gt;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#estado_libertad -->

    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#estado_libertad">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>libre</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>preso</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Describe la situacion actual de libertad de un Personaje. Su valor debe 
      mantenerse coherente con la relacion esta_preso_por. Solo puede tomar 
      los valores libre o preso.
    &lt;/p&gt;</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#estado_vital -->

    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#estado_vital">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>muerto</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>vivo</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Describe la situacion vital de un Personaje. Solo puede tomar los 
      valores vivo o muerto.
    &lt;/p&gt;</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Arma -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Arma">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Objetos de car&amp;#225;cter ofensivo utilizados para el combate o asesinato.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#ArtefactoMagico -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#ArtefactoMagico">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Objetos con propiedades o poderes sobrenaturales.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad">
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Concepto que representa las habilidades o poderes que poseen los 
      personajes o que son proporcionados por los objetos.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Criatura -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Criatura">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Monstruos, bestias y seres mitol&amp;#243;gicos.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Dios -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Dios">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Deidades de la mitolog&amp;#237;a griega, tanto principales como menores.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Heroe -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Heroe">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Personajes que llevan a cabo misiones y haza&amp;#241;as.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Mortal -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Mortal">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Personajes humanos sin capacidades divinas directas.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#proporciona_capacidad"/>
                <owl:allValuesFrom rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Concepto central para los items o artefactos que los personajes pueden 
      conseguir y utilizar.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#ParteAnatomica -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#ParteAnatomica">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Restos biol&amp;#243;gicos de criaturas que se obtienen y utlizan como objetos.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_capacidad"/>
                <owl:allValuesFrom rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Capacidad"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_enojo"/>
                <owl:allValuesFrom rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Dios"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_favor"/>
                <owl:allValuesFrom rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Dios"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#tiene_objeto"/>
                <owl:allValuesFrom rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#estado_libertad"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#estado_vital"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Concepto central para abarcar a todos los actores del mito
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Proteccion -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Proteccion">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Objeto"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Objetos de car&amp;#225;cter defensivo.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Semidios -->

    <owl:Class rdf:about="http://www.owl-ontologies.com/Ontology1793785230.owl#Semidios">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/Ontology1793785230.owl#Personaje"/>
        <rdfs:comment>&lt;p style=&quot;margin-top: 0&quot;&gt;
      Personajes descendientes de un dios y un mortal.
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.owl-ontologies.com/Ontology1793785230.owl#Andromeda -->

   
