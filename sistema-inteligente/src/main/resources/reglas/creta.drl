package reglas

import dsi.mitologia.modelo.Personaje
import dsi.mitologia.modelo.Objeto
import dsi.mitologia.modelo.Lugar
import dsi.mitologia.hechos.Posesion
import dsi.mitologia.hechos.Ubicacion
import dsi.mitologia.hechos.Muerte
import dsi.mitologia.hechos.Enojo
import dsi.mitologia.hechos.Cautiverio
import dsi.mitologia.hechos.Filiacion
import dsi.mitologia.hechos.Liberacion
import dsi.mitologia.hechos.CapacidadDisponible
import dsi.mitologia.hechos.EstadoFisicoObjeto
import dsi.mitologia.modelo.Capacidad
import dsi.mitologia.eventos.EventoMitologico
import dsi.mitologia.eventos.TipoAccion
import dsi.mitologia.modelo.enums.EstadoVital
import dsi.mitologia.modelo.enums.EstadoLibertad

global dsi.mitologia.eventos.RegistroEventos registro

rule "C01 Entrar en el laberinto con el hilo de Ariadna y un arma"
when
    $h    : Personaje(heroe, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
    $u    : Ubicacion(personaje == $h, lugar.id == "MundoExterior")
    $hilo : Objeto(id == "HiloAriadna")
            Posesion(poseedor == $h, objeto == $hilo)
            Posesion(poseedor == $h, $arma : objeto)
            Objeto(this == $arma, arma)
    $m    : Personaje(criatura, estadoVital == EstadoVital.VIVO)
            Ubicacion(personaje == $m, $lab : lugar, lugar.id == "LaberintoCreta")
then
    modify($u) { setLugar($lab) }
    registro.registrar(EventoMitologico.nuevo(TipoAccion.ENTRAR, $h).destinatario($lab).objeto($hilo)
        .descripcion($h.getNombre() + " entra en " + $lab.getNombre() + " debido a tener " + $hilo.getNombre()
            + " y " + $arma.getNombre() + " para enfrentarse a " + $m.getNombre())
        .justificacion("tener " + $hilo.getNombre() + " y " + $arma.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C02 Matar con un arma a la criatura del laberinto"
    salience -10
when
    $h    : Personaje(heroe, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
            Ubicacion(personaje == $h, $lab : lugar, lugar.id == "LaberintoCreta")
    $m    : Personaje(criatura, estadoVital == EstadoVital.VIVO)
            Ubicacion(personaje == $m, lugar == $lab)
            Posesion(poseedor == $h, $arma : objeto)
            Objeto(this == $arma, arma)
then
    modify($m) { setEstadoVital(EstadoVital.MUERTO) }
    insert(new Muerte($h, $m));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.MATAR, $h).destinatario($m).objeto($arma)
        .descripcion($h.getNombre() + " mata a " + $m.getNombre() + " debido a tener " + $arma.getNombre()
            + " y estar con el en " + $lab.getNombre())
        .justificacion("tener " + $arma.getNombre() + " y estar en " + $lab.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C03 Salir del laberinto siguiendo el hilo de Ariadna"
    salience -20
when
    $h    : Personaje(heroe, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
    $u    : Ubicacion(personaje == $h, $lab : lugar, lugar.id == "LaberintoCreta")
    $hilo : Objeto(id == "HiloAriadna")
            Posesion(poseedor == $h, objeto == $hilo)
            Muerte(asesino == $h, $v : victima)
            Ubicacion(personaje == $v, lugar == $lab)
    $ext  : Lugar(id == "MundoExterior")
then
    modify($u) { setLugar($ext) }
    registro.registrar(EventoMitologico.nuevo(TipoAccion.SALIR, $h).destinatario($lab).objeto($hilo)
        .descripcion($h.getNombre() + " sale de " + $lab.getNombre() + " debido a seguir " + $hilo.getNombre()
            + " tras matar a " + $v.getNombre())
        .justificacion("tener " + $hilo.getNombre() + " y haber matado a " + $v.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C04 Minos se enoja con Dedalo cuando alguien entra y sale del laberinto"
when
    $minos : Personaje(id == "Minos", estadoVital == EstadoVital.VIVO)
    $ded   : Personaje(id == "Dedalo", estadoVital == EstadoVital.VIVO)
             Muerte($h : asesino, $m : victima)
             Ubicacion(personaje == $m, $lab : lugar, lugar.id == "LaberintoCreta")
             Ubicacion(personaje == $h, lugar.id == "MundoExterior")
             not Enojo(personaje == $ded, dios == $minos)
then
    insert(new Enojo($ded, $minos));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.PROVOCAR_ENOJO, $minos).destinatario($ded)
        .descripcion($minos.getNombre() + " se enoja con " + $ded.getNombre() + " debido a que " + $h.getNombre()
            + " ha entrado y salido de " + $lab.getNombre() + " y ha matado a " + $m.getNombre())
        .justificacion($h.getNombre() + " ha entrado y salido de " + $lab.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C05 Minos encierra en el laberinto a quien le enoja"
    salience 10
when
    $minos : Personaje(id == "Minos", estadoVital == EstadoVital.VIVO)
             Enojo($x : personaje, dios == $minos)
    $xP    : Personaje(this == $x, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
    $u     : Ubicacion(personaje == $x, lugar.id == "MundoExterior")
             not Liberacion(liberado == $x)
    $lab   : Lugar(id == "LaberintoCreta")
then
    modify($u) { setLugar($lab) }
    modify($xP) { setEstadoLibertad(EstadoLibertad.PRESO) }
    insert(new Cautiverio($minos, $x));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.APRESAR, $minos).destinatario($x)
        .descripcion($minos.getNombre() + " encierra a " + $x.getNombre() + " en " + $lab.getNombre()
            + " debido a su enojo con " + $x.getNombre())
        .justificacion("el enojo de " + $minos.getNombre() + " con " + $x.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C06 Minos encierra tambien a los hijos de quien le enoja"
    salience 9
when
    $minos : Personaje(id == "Minos", estadoVital == EstadoVital.VIVO)
             Enojo($x : personaje, dios == $minos)
             Filiacion($y : hijo, progenitor == $x)
    $yP    : Personaje(this == $y, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
    $u     : Ubicacion(personaje == $y, lugar.id == "MundoExterior")
             not Liberacion(liberado == $y)
    $lab   : Lugar(id == "LaberintoCreta")
then
    modify($u) { setLugar($lab) }
    modify($yP) { setEstadoLibertad(EstadoLibertad.PRESO) }
    insert(new Cautiverio($minos, $y));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.APRESAR, $minos).destinatario($y)
        .descripcion($minos.getNombre() + " encierra a " + $y.getNombre() + " en " + $lab.getNombre()
            + " debido a ser hijo de " + $x.getNombre())
        .justificacion("ser hijo de " + $x.getNombre() + ", que ha enojado a " + $minos.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C07 Quien esta encerrado en el laberinto encuentra cera y plumas"
when
    $x   : Personaje(estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.PRESO)
           Ubicacion(personaje == $x, $lab : lugar, lugar.id == "LaberintoCreta")
    $o   : Objeto(id == "CeraAbejas" || id == "PlumasAve")
           not Posesion(objeto == $o)
then
    insert(new Posesion($x, $o));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.OBTENER_OBJETO, $x).objeto($o)
        .descripcion($x.getNombre() + " encuentra " + $o.getNombre() + " en " + $lab.getNombre())
        .justificacion("estar encerrado en " + $lab.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C08 Dedalo fabrica sus alas con cera y plumas"
when
    $d    : Personaje(id == "Dedalo", estadoVital == EstadoVital.VIVO)
            Ubicacion(personaje == $d, lugar.id == "LaberintoCreta")
    $cera : Objeto(id == "CeraAbejas")
    $plum : Objeto(id == "PlumasAve")
            Posesion(objeto == $cera)
            Posesion(objeto == $plum)
    $alas : Objeto(id == "AlasDedalo")
            not Posesion(objeto == $alas)
then
    insert(new Posesion($d, $alas));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.OBTENER_OBJETO, $d).objeto($alas)
        .descripcion($d.getNombre() + " fabrica " + $alas.getNombre() + " debido a tener " + $cera.getNombre()
            + " y " + $plum.getNombre())
        .justificacion("tener " + $cera.getNombre() + " y " + $plum.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C09 Dedalo fabrica las alas de su hijo encerrado con el"
when
    $d    : Personaje(id == "Dedalo", estadoVital == EstadoVital.VIVO)
            Ubicacion(personaje == $d, $lab : lugar, lugar.id == "LaberintoCreta")
            Filiacion($y : hijo, progenitor == $d)
    $yP   : Personaje(this == $y, estadoVital == EstadoVital.VIVO)
            Ubicacion(personaje == $y, lugar == $lab)
    $cera : Objeto(id == "CeraAbejas")
    $plum : Objeto(id == "PlumasAve")
            Posesion(objeto == $cera)
            Posesion(objeto == $plum)
    $alas : Objeto(id == "AlasIcaro")
            not Posesion(objeto == $alas)
then
    insert(new Posesion($y, $alas));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.ENTREGAR_OBJETO, $d).destinatario($y).objeto($alas)
        .descripcion($d.getNombre() + " fabrica " + $alas.getNombre() + " para " + $y.getNombre()
            + " debido a tener " + $cera.getNombre() + " y " + $plum.getNombre())
        .justificacion("tener " + $cera.getNombre() + " y " + $plum.getNombre())
        .regla(drools.getRule().getName()));
end

rule "C10 Escapar volando del laberinto"
when
    $x   : Personaje(estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.PRESO)
    $u   : Ubicacion(personaje == $x, $lab : lugar, lugar.id == "LaberintoCreta")
    $vue : Capacidad(id == "Vuelo")
    $cv  : CapacidadDisponible(personaje == $x, capacidad == $vue)
    $cau : Cautiverio(preso == $x)
    $ext : Lugar(id == "MundoExterior")
then
    delete($cau);
    modify($x) { setEstadoLibertad(EstadoLibertad.LIBRE) }
    modify($u) { setLugar($ext) }
    insert(new Liberacion($x, $x));
    registro.registrar(EventoMitologico.nuevo(TipoAccion.SALIR, $x).destinatario($lab)
        .descripcion($x.getNombre() + " escapa volando de " + $lab.getNombre() + " debido a tener Vuelo ("
            + $cv.getNombreFuente() + ")")
        .justificacion("tener Vuelo (" + $cv.getNombreFuente() + ")")
        .regla(drools.getRule().getName()));
end

rule "C11 El hijo muere al escapar volando y sus alas se rompen"
    salience -5
when
    $minos : Personaje(id == "Minos")
             Enojo($p : personaje, dios == $minos)
             Filiacion($y : hijo, progenitor == $p)
    $yP    : Personaje(this == $y, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
             Ubicacion(personaje == $y, lugar.id == "MundoExterior")
             Personaje(this == $p, estadoVital == EstadoVital.VIVO, estadoLibertad == EstadoLibertad.LIBRE)
             Ubicacion(personaje == $p, lugar.id == "MundoExterior")
    $vue   : Capacidad(id == "Vuelo")
             CapacidadDisponible(personaje == $y, capacidad == $vue, $alas : fuente)
    $ef    : EstadoFisicoObjeto(objeto == $alas, condicion == "intacto")
then
    modify($yP) { setEstadoVital(EstadoVital.MUERTO) }
    modify($ef) { setCondicion("roto") }
    registro.registrar(EventoMitologico.nuevo(TipoAccion.MORIR, $y).objeto($ef.getObjeto())
        .descripcion($y.getNombre() + " muere al escapar volando y " + $ef.getObjeto().getNombre()
            + " quedan rotas donde cae")
        .justificacion("volar demasiado alto al escapar con " + $p.getNombre())
        .regla(drools.getRule().getName()));
end
